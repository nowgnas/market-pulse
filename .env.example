# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Services
# 현재 provider 시도 순서: Gemini -> OpenAI -> Claude
# 운영에서는 GEMINI_API_KEY + GEMINI_MODEL 설정을 권장합니다
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Cron Secret (for Vercel Cron Jobs)
CRON_SECRET=your_cron_secret_key

# Auto posting is disabled unless this is explicitly set to true.
ENABLE_AUTO_POSTING=false
